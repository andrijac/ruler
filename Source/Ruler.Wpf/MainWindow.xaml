<!-- 
    MainWindow.xaml
    
    This file defines the user interface for the ruler application.
    It uses a transparent, borderless window to create the ruler effect.
    The ContextMenu provides all the functionality found in the original
    WinForms application, with each MenuItem bound to a command in the
    RulerViewModel.
-->
<Window x:Class="Ruler.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ruler.Wpf.Common"
        xmlns:models ="clr-namespace:Ruler.Wpf.Models"
        mc:Ignorable="d"
        Title="Ruler"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Height="{Binding Height}"
        Width="{Binding Width}"
        Left="{Binding DisplayedLocation.X}"
        Top="{Binding DisplayedLocation.Y}"
        Opacity="{Binding Opacity}"
        Topmost="{Binding TopMost}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" >

    <Window.Resources>
        <DataTemplate x:Key="TopHorizontalRulerTickTemplate">
            <Grid>
                <StackPanel Orientation="Vertical">
                    <Rectangle Fill="#bbb" Width="1" Height="{Binding TickSize}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" />
                    <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- DataTemplate for the bottom horizontal ruler ticks, with a vertical flip -->
        <DataTemplate x:Key="BottomHorizontalRulerTickTemplate">
            <Grid>
                <StackPanel Orientation="Vertical">
                    <Rectangle Fill="#bbb" Width="1" Height="{Binding TickSize}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleY="-1"/>
                        </Rectangle.RenderTransform>

                    </Rectangle>
                    <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- DataTemplate for the left vertical ruler ticks -->
        <DataTemplate x:Key="LeftVerticalRulerTickTemplate">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Fill="#bbb" Height="1" Width="{Binding TickSize}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" />
                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Top" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- DataTemplate for the right vertical ruler ticks, with a horizontal flip -->
        <DataTemplate x:Key="RightVerticalRulerTickTemplate">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Fill="#bbb" Height="1" Width="{Binding TickSize}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="-1"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Top" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="3"
                BorderBrush="#333" BorderThickness="1" CornerRadius="5" Background="#555" >
            <Border.ContextMenu>
                <ContextMenu Background="#444" Foreground="#fff" FontSize="14">
                    <MenuItem Header="Always on Top" IsCheckable="True" IsChecked="{Binding TopMost}" Command="{Binding ToggleTopMostCommand}"/>
                    <MenuItem Header="Change Orientation" Command="{Binding ToggleOrientationCommand}"/>
                    <MenuItem Header="Tool Tip" IsCheckable="True" IsChecked="{Binding ShowToolTip}" Command="{Binding ToggleToolTipCommand}"/>
                    <MenuItem Header="Lock Resize" IsCheckable="True" IsChecked="{Binding IsLocked}" Command="{Binding ToggleLock}" />
                    <MenuItem Header="Duplicate Ruler" Command="{Binding DuplicateCommand}"/>
                    <MenuItem Header="Reset to Defaults" Command="{Binding ResetToDefaultCommand}" />
                    <Separator/>
                    <MenuItem Header="Opacity">
                        <MenuItem Header="5%" Command="{Binding SetOpacityCommand}" CommandParameter="0.05" IsCheckable="True" IsChecked="{Binding IsOpacity5Percent}"/>
                        <MenuItem Header="10%" Command="{Binding SetOpacityCommand}" CommandParameter="0.1" IsCheckable="True" IsChecked="{Binding IsOpacity10Percent}"/>
                        <MenuItem Header="15%" Command="{Binding SetOpacityCommand}" CommandParameter="0.15" IsCheckable="True" IsChecked="{Binding IsOpacity15Percent}"/>
                        <MenuItem Header="20%" Command="{Binding SetOpacityCommand}" CommandParameter="0.2" IsCheckable="True" IsChecked="{Binding IsOpacity20Percent}"/>
                        <MenuItem Header="25%" Command="{Binding SetOpacityCommand}" CommandParameter="0.25" IsCheckable="True" IsChecked="{Binding IsOpacity25Percent}"/>
                        <MenuItem Header="30%" Command="{Binding SetOpacityCommand}" CommandParameter="0.3" IsCheckable="True" IsChecked="{Binding IsOpacity30Percent}"/>
                        <MenuItem Header="35%" Command="{Binding SetOpacityCommand}" CommandParameter="0.35" IsCheckable="True" IsChecked="{Binding IsOpacity35Percent}" />
                        <MenuItem Header="40%" Command="{Binding SetOpacityCommand}" CommandParameter="0.4" IsCheckable="True" IsChecked="{Binding IsOpacity40Percent}" />
                        <MenuItem Header="45%" Command="{Binding SetOpacityCommand}" CommandParameter="0.45" IsCheckable="True" IsChecked="{Binding IsOpacity45Percent}"/>
                        <MenuItem Header="50%" Command="{Binding SetOpacityCommand}" CommandParameter="0.5" IsCheckable="True" IsChecked="{Binding IsOpacity50Percent}"/>
                        <MenuItem Header="55%" Command="{Binding SetOpacityCommand}" CommandParameter="0.55" IsCheckable="True" IsChecked="{Binding IsOpacity55Percent}"/>
                        <MenuItem Header="60%" Command="{Binding SetOpacityCommand}" CommandParameter="0.6" IsCheckable="True" IsChecked="{Binding IsOpacity60Percent}"/>
                        <MenuItem Header="65%" Command="{Binding SetOpacityCommand}" CommandParameter="0.65" IsCheckable="True" IsChecked="{Binding IsOpacity65Percent}"/>
                        <MenuItem Header="70%" Command="{Binding SetOpacityCommand}" CommandParameter="0.7" IsCheckable="True" IsChecked="{Binding IsOpacity70Percent}"/>
                        <MenuItem Header="75%" Command="{Binding SetOpacityCommand}" CommandParameter="0.75" IsCheckable="True" IsChecked="{Binding IsOpacity75Percent}"/>
                        <MenuItem Header="80%" Command="{Binding SetOpacityCommand}" CommandParameter="0.8" IsCheckable="True" IsChecked="{Binding IsOpacity80Percent}"/>
                        <MenuItem Header="85%" Command="{Binding SetOpacityCommand}" CommandParameter="0.85" IsCheckable="True" IsChecked="{Binding IsOpacity85Percent}"/>
                        <MenuItem Header="90%" Command="{Binding SetOpacityCommand}" CommandParameter="0.9" IsCheckable="True" IsChecked="{Binding IsOpacity90Percent}"/>
                        <MenuItem Header="95%" Command="{Binding SetOpacityCommand}" CommandParameter="0.95" IsCheckable="True" IsChecked="{Binding IsOpacity95Percent}"/>
                        <MenuItem Header="100%" Command="{Binding SetOpacityCommand}" CommandParameter="1.0" IsCheckable="True" IsChecked="{Binding IsOpacity100Percent}"/>
                    </MenuItem>
                    <MenuItem Header="Save?">
                        <MenuItem Header="Save Nothing" Command="{Binding SetSaveCommand}" CommandParameter="nonw" IsCheckable="True" IsChecked="{Binding IsSaveTypeNone}"/>
                        <MenuItem Header="Save Location" Command="{Binding SetSaveCommand}" CommandParameter="location" IsCheckable="True" IsChecked="{Binding IsSaveTypeLocation}"/>
                        <MenuItem Header="Save Size" Command="{Binding SetSaveCommand}" CommandParameter="size" IsCheckable="True" IsChecked="{Binding IsSaveTypeSize}" />
                        <MenuItem Header="Save Everything" Command="{Binding SetSaveCommand}" CommandParameter="all" IsCheckable="True" IsChecked="{Binding IsSaveTypeAll}"/>

                    </MenuItem>
                    <!--<MenuItem Header="Scale">
                        <MenuItem Header="1x" Command="{Binding SetScaleCommand}" CommandParameter="1" IsCheckable="True" IsChecked="{Binding Scale, Converter={Binding Source={x:Reference MainWindows}, Path=IntToBool}, ConverterParameter=1}"/>
                        <MenuItem Header="2x" Command="{Binding SetScaleCommand}" CommandParameter="2" IsCheckable="True" IsChecked="{Binding Scale, Converter={Binding Source={x:Reference MainWindows}, Path=IntToBool}, ConverterParameter=2}"/>
                        <MenuItem Header="4x" Command="{Binding SetScaleCommand}" CommandParameter="4" IsCheckable="True" IsChecked="{Binding Scale, Converter={Binding Source={x:Reference MainWindows}, Path=IntToBool}, ConverterParameter=4}"/>
                        <MenuItem Header="8x" Command="{Binding SetScaleCommand}" CommandParameter="8" IsCheckable="True" IsChecked="{Binding Scale, Converter={Binding Source={x:Reference MainWindows}, Path=IntToBool}, ConverterParameter=8}"/>
                    </MenuItem>-->
                    <Separator/>
                    <MenuItem Header="Close" Command="{Binding CloseCommand}"/>
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        <!-- Top/Left Ruler Ticks -->
        <ItemsControl Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding TopRulerTicks}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="ItemTemplate" Value="{StaticResource TopHorizontalRulerTickTemplate}"/>
                    <Setter Property="ItemContainerStyle">
                        <Setter.Value>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Position}"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVertical}" Value="True">
                            <Setter Property="Grid.Row" Value="1"/>
                            <Setter Property="Grid.Column" Value="0"/>
                            <Setter Property="ItemTemplate" Value="{StaticResource LeftVerticalRulerTickTemplate}"/>
                            <Setter Property="ItemContainerStyle">
                                <Setter.Value>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="{Binding Position}"/>
                                    </Style>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Center content for width and height display -->
        <StackPanel Grid.Row="1" Grid.Column="1"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVertical}" Value="True">
                            <Setter Property="Orientation" Value="Horizontal"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding FormattedWidth}" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding FormattedHeight}" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <!-- Bottom/Right Ruler Ticks -->
        <ItemsControl Grid.Row="2" Grid.Column="1"
                      ItemsSource="{Binding BottomRulerTicks}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="ItemTemplate" Value="{StaticResource BottomHorizontalRulerTickTemplate}"/>
                    <Setter Property="ItemContainerStyle">
                        <Setter.Value>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Position}"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVertical}" Value="True">
                            <Setter Property="Grid.Row" Value="1"/>
                            <Setter Property="Grid.Column" Value="2"/>
                            <Setter Property="ItemTemplate" Value="{StaticResource RightVerticalRulerTickTemplate}"/>
                            <Setter Property="ItemContainerStyle">
                                <Setter.Value>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="{Binding Position}"/>
                                    </Style>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</Window>
