<!-- 
    MainWindow.xaml
    
    This file defines the user interface for the ruler application.
    It uses a transparent, borderless window to create the ruler effect.
    The ContextMenu provides all the functionality found in the original
    WinForms application, with each MenuItem bound to a command in the
    RulerViewModel.
-->
<Window x:Class="Ruler.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ruler.Wpf.Common"
        xmlns:models ="clr-namespace:Ruler.Wpf.Models"
        mc:Ignorable="d"
        Title="Ruler"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Height="{Binding Height}"
        Width="{Binding Width}"
        Left="{Binding DisplayedLocation.X}"
        Top="{Binding DisplayedLocation.Y}"
        Opacity="{Binding Opacity}"
        Topmost="{Binding TopMost}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" >

    <Window.Resources>
        <!-- Style to make menu items feel more modern -->
        <Style TargetType="MenuItem">
            <!-- Default background color -->
            <Setter Property="Background" Value="White" />
            <!-- Trigger to change the background color when the item is checked -->
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="LightCyan" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <local:CenterConverter x:Key="CenterConverter" />
        <local:ValueToBooleanConverter x:Key="ValueToBooleanConverter" />
    </Window.Resources>

    <!-- This Border is the visual representation of the ruler -->
    <Border x:Name="resizingArea"   
            Background="LightGray"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            >

        <!-- The ContextMenu is the primary way to interact with the ruler -->
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Set Size..." Command="{Binding ShowSetSizeFormCommand}" />
                <MenuItem Header="Opacity">
                    <MenuItem Header="10%" Command="{Binding SetOpacityCommand}" CommandParameter="0.1" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.05}" />
                    <MenuItem Header="10%" Command="{Binding SetOpacityCommand}" CommandParameter="0.1" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.1}" />
                    <MenuItem Header="15%" Command="{Binding SetOpacityCommand}" CommandParameter="0.15" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.15}" />
                    <MenuItem Header="20%" Command="{Binding SetOpacityCommand}" CommandParameter="0.2" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.2}" />
                    <MenuItem Header="25%" Command="{Binding SetOpacityCommand}" CommandParameter="0.25" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.25}" />
                    <MenuItem Header="30%" Command="{Binding SetOpacityCommand}" CommandParameter="0.3" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.3}" />
                    <MenuItem Header="35%" Command="{Binding SetOpacityCommand}" CommandParameter="0.35" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.35}" />
                    <MenuItem Header="40%" Command="{Binding SetOpacityCommand}" CommandParameter="0.4" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.4}" />
                    <MenuItem Header="45%" Command="{Binding SetOpacityCommand}" CommandParameter="0.45" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.45}" />
                    <MenuItem Header="50%" Command="{Binding SetOpacityCommand}" CommandParameter="0.5" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.5}" />
                    <MenuItem Header="55%" Command="{Binding SetOpacityCommand}" CommandParameter="0.55"  IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.55}" />
                    <MenuItem Header="60%" Command="{Binding SetOpacityCommand}" CommandParameter="0.6" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.6}" />
                    <MenuItem Header="65%" Command="{Binding SetOpacityCommand}" CommandParameter="0.65" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.65}" />
                    <MenuItem Header="70%" Command="{Binding SetOpacityCommand}" CommandParameter="0.7"  IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.7}" />
                    <MenuItem Header="75%" Command="{Binding SetOpacityCommand}" CommandParameter="0.75" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.75}" />
                    <MenuItem Header="80%" Command="{Binding SetOpacityCommand}" CommandParameter="0.8" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.8}" />
                    <MenuItem Header="85%" Command="{Binding SetOpacityCommand}" CommandParameter="0.85" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.85}" />
                    <MenuItem Header="90%" Command="{Binding SetOpacityCommand}" CommandParameter="0.9" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.9}" />
                    <MenuItem Header="95%" Command="{Binding SetOpacityCommand}" CommandParameter="0.95" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=0.95}" />
                    <MenuItem Header="100%" Command="{Binding SetOpacityCommand}" CommandParameter="1.0" IsChecked="{Binding Opacity, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter=1.0}" />
                </MenuItem>
                <MenuItem Header="Vertical" Command="{Binding ToggleVerticalCommand}" IsChecked="{Binding IsVertical}" />
                <MenuItem Header="Always on Top" Command="{Binding ToggleTopMostCommand}" IsChecked="{Binding TopMost}" />
                <MenuItem Header="Lock Ruler" Command="{Binding ToggleLockCommand}" IsChecked="{Binding IsLocked}" />
                <MenuItem Header="Show ToolTip" Command="{Binding ToggleToolTipCommand}" IsChecked="{Binding ShowToolTip}" />
                <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />

                <Separator />

                <MenuItem Header="Save Settings">
                    <MenuItem Header="None"
                                  Command="{Binding SetSaveTypeCommand}"
                                  CommandParameter="{x:Static local:SaveTypes.none}"
                                  IsChecked="{Binding SaveType, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter={x:Static local:SaveTypes.none}}" />
                    <MenuItem Header="All"
                                  Command="{Binding SetSaveTypeCommand}"
                                  CommandParameter="{x:Static local:SaveTypes.all}"
                                  IsChecked="{Binding SaveType, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter={x:Static local:SaveTypes.all}}" />
                    <MenuItem Header="Location"
                                  Command="{Binding SetSaveTypeCommand}"
                                  CommandParameter="{x:Static local:SaveTypes.location}"
                                  IsChecked="{Binding SaveType, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter={x:Static local:SaveTypes.location}}" />
                    <MenuItem Header="Size"
                                  Command="{Binding SetSaveTypeCommand}"
                                  CommandParameter="{x:Static local:SaveTypes.size}"
                                  IsChecked="{Binding SaveType, Converter={StaticResource ValueToBooleanConverter}, ConverterParameter={x:Static local:SaveTypes.size}}" />
                </MenuItem>

                <Separator />

                <MenuItem Header="About" Command="{Binding ShowAboutCommand}" />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </Border.ContextMenu>
        <!--
            The Grid is used to layer multiple elements on top of each other.
            We will place two ItemsControl elements here to draw the lines and the text.
            The TextBlock that previously displayed the size has been removed, as
            that functionality will now be handled by the ItemsControl binding to RulerLabels.
            -->
        <Grid>
            
                <!-- Single ItemsControl to display both lines and labels -->
            <ItemsControl ItemsSource="{Binding RulerTicks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="AliceBlue" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type models:LineInfo}">
                        <Line X1="{Binding X1}" Y1="{Binding Y1}"
                      X2="{Binding X2}" Y2="{Binding Y2}"
                      Stroke="Black"
                      StrokeThickness="{Binding Thickness}"/>
                    </DataTemplate>

                    <!-- DataTemplate for LabelInfo objects -->
                    <DataTemplate DataType="{x:Type models:LabelInfo}">
                        <TextBlock Text="{Binding Text}"
                           Canvas.Left="{Binding LabelX}"
                           Canvas.Top="{Binding LabelY}"
                           FontSize="{Binding FontSize}"
                           Foreground="{Binding Foreground}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Style.Triggers>
                                        <!-- Rotate the text 90 degrees when the ruler is vertical -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=DataContext.Orientation}" Value="Vertical">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="-90"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>

            <!-- This TextBlock will display the current size of the ruler -->
            <TextBlock Text="{Binding SizeText}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="12"
                  FontWeight="Bold"
                  Foreground="Black"
                  />
        </Grid>
    </Border>
</Window>
