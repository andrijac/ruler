<Window x:Class="Ruler.Wpf.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update" Height="280" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#2D3033" Foreground="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Check for a new version" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding VersionInfoText}" FontSize="12" Foreground="#AAAAAA" Grid.Row="1" Margin="0,0,0,10"/>

        <TextBox Grid.Row="2" IsReadOnly="True" 
                 Background="#1E1E1E" Foreground="#DDDDDD" BorderBrush="#444"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 Padding="8" Text="{Binding ReleaseNotesText, Mode=OneWay}"/>

        <!-- Progress and status -->
        <ProgressBar Grid.Row="3" Height="6" Margin="0,12,0,0" IsIndeterminate="True" 
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="11" Foreground="#888" 
                   HorizontalAlignment="Center" Margin="0,4,0,0"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Check for Updates" Width="120" Height="26" Margin="0,0,8,0" 
                    Command="{Binding CheckForUpdatesCommand}"/>
            <Button Content="Cancel" Width="90" Height="26" Margin="0,0,8,0" 
                    Command="{Binding CancelCommand}"/>
            <Button Content="Download &amp; Install" Width="130" Height="26" 
                    Command="{Binding DownloadAndInstallCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>