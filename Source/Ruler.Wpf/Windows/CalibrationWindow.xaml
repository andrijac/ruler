<Window x:Class="Ruler.Wpf.Windows.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate Monitor" Height="600" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F7">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Instructions -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14" Foreground="#333333" Margin="0,0,0,24">
            Hold a standard credit card (85.6 mm x 54.0 mm) up to your screen. Use the slider below to adjust the card preview until its physical size matches your card exactly.
        </TextBlock>

        <!-- Visual Preview Box styled as a Credit Card -->
        <Border Grid.Row="1" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="{Binding CardPixelWidth}" Height="{Binding CardPixelHeight}"
                CornerRadius="12" BorderBrush="#333333" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2C3E50" Offset="0.0"/>
                    <GradientStop Color="#1A252F" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="6" Opacity="0.4"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Row: Simulated EMV Chip -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="42" Height="30" CornerRadius="4" Background="#E5C158" BorderBrush="#B89728" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                             </Grid.ColumnDefinitions>
                                <Border BorderBrush="#B89728" BorderThickness="0.5" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Middle Row: Text Prompt -->
                <TextBlock Grid.Row="1" Text="Place Physical Credit Card Here" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#A6B9C7" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"/>

                <!-- Bottom Row: Dimensions Label -->
                <TextBlock Grid.Row="2" Text="85.6 mm × 54.0 mm" 
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Foreground="#7F8C8D" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Adjustment Slider -->
        <StackPanel Grid.Row="2" Margin="0,28,0,28">
            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <TextBlock Text="Adjustment Scale:" FontWeight="Medium" VerticalAlignment="Center" FontSize="13"/>
                <TextBlock Text="{Binding CurrentMultiplier, StringFormat={}{0:F3}x}" 
                           DockPanel.Dock="Right" FontWeight="Bold" VerticalAlignment="Center" Foreground="#007ACC" FontSize="13"/>
            </DockPanel>
            <Slider Minimum="0.5" Maximum="5.0" Value="{Binding CurrentMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    TickFrequency="0.01" IsSnapToTickEnabled="False"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Height="34" Margin="0,0,12,0" Command="{Binding CancelCommand}"/>
            <Button Content="Save Calibration" Width="140" Height="34" Command="{Binding SaveCommand}" 
                    Background="#007ACC" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>