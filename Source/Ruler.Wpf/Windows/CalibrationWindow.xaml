<Window x:Class="Ruler.Wpf.Windows.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate Monitor" Height="420" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F7">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Instructions -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14" Foreground="#333333">
            Hold a standard credit card (85.6 mm $\times$ 54.0 mm) up to your screen. Use the slider below to adjust the box until its size matches the physical card exactly.
        </TextBlock>

        <!-- Visual Preview Box representing the card -->
        <Border Grid.Row="1" Background="#E3E3E8" BorderBrush="#007ACC" BorderThickness="2" 
                CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="{Binding CardPixelWidth}" Height="{Binding CardPixelHeight}">
            <TextBlock Text="Place Credit Card Here" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#666666" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- Adjustment Slider -->
        <StackPanel Grid.Row="2" Margin="0,16,0,24">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Adjustment Scale:" FontWeight="Medium" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentMultiplier, StringFormat={}{0:F3}x}" 
                           DockPanel.Dock="Right" FontWeight="Bold" VerticalAlignment="Center" Foreground="#007ACC"/>
            </DockPanel>
            <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.01" 
                    IsSnapToTickEnabled="False" ValueChanged="ScaleSlider_ValueChanged" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,12,0" Click="CancelButton_Click"/>
            <Button Content="Save Calibration" Width="120" Height="30" Click="SaveButton_Click" 
                    Background="#007ACC" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>