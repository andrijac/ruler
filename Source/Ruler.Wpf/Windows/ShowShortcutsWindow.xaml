<Window x:Class="Ruler.Wpf.Windows.ShowShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts" 
        Height="520" Width="480" 
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" 
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="25,15,25,25">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl>
                        <!-- Style selector or data trigger can separate Headers from Rows -->
                    </ContentControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>