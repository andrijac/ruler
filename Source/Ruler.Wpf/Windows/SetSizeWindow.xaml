<Window x:Class="Ruler.Wpf.Windows.SetSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Size" Height="236" Width="373" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,10">
            <Label Content="Width (px)" Width="100"/>
            <TextBox x:Name="txtWidth" Width="100" GotKeyboardFocus="HandleTextBoxFocus"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10">
            <Label Content="Height (px)" Width="100"/>
            <TextBox x:Name="txtHeight" Width="100" GotKeyboardFocus="HandleTextBoxFocus"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button Content="Ok" Width="75" Margin="5" Click="BtnOk_Click"/>
            <Button Content="Cancel" Width="75" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>