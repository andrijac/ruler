<Window x:Class="Ruler.Wpf.Windows.SetSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Size" Height="236" Width="373" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,10">
            <Label Content="{Binding WidthLabel}" Width="100"/>
            <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" Width="100" GotKeyboardFocus="HandleTextBoxFocus"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10">
            <Label Content="{Binding HeightLabel}" Width="100"/>
            <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" Width="100" GotKeyboardFocus="HandleTextBoxFocus"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10">
            <Label Content="Unit Type" Width="100"/>
            <ComboBox ItemsSource="{Binding AvailableUnits}" SelectedItem="{Binding SelectedUnit}" Width="150"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button Content="Ok" Width="75" Margin="5" Command="{Binding OkCommand}" IsDefault="True"/>
            <Button Content="Cancel" Width="75" Margin="5" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>