<Window x:Class="Ruler.Wpf.Views.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ruler.Wpf.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1E1E1E"
        BorderBrush="#333333"
        BorderThickness="1"
        Width="450"
        Height="550"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ruler Keyboard Shortcuts" 
                   Foreground="White" 
                   FontSize="18" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <TextBlock Text="Core Controls" Foreground="DarkCyan" FontWeight="Bold" Margin="0,5,0,5"/>
                <UniformGrid Columns="2" Margin="0,0,0,15">
                    <TextBlock Text="Space / O" Foreground="#AAAAAA"/>
                    <TextBlock Text="Flip Orientation" Foreground="White" FontWeight="SemiBold"/>

                    <TextBlock Text="L" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                    <TextBlock Text="Lock / Unlock Resizing" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/>

                    <TextBlock Text="G" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                    <TextBlock Text="Toggle Guideline Visibility" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/>

                    <TextBlock Text="D" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                    <TextBlock Text="Duplicate Active Ruler" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/>

                    <TextBlock Text="Esc" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                    <TextBlock Text="Close Active Ruler" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/>

                    <TextBlock Text="Ctrl + Esc" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                    <TextBlock Text="Exit All Application Instances" Foreground="#C62828" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </UniformGrid>

                <TextBlock Text="Nudging &amp; Sizing" Foreground="DarkCyan" FontWeight="Bold" Margin="0,5,0,5"/>
                <UniformGrid Columns="2" Margin="0,0,0,15">
                    <TextBlock Text="Arrow Keys" Foreground="#AAAAAA"/>
                    <TextBlock Text="Nudge Ruler 10px" Foreground="White" FontWeight="SemiBold"/>

                    <TextBlock Text="Ctrl + Arrow Keys" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                    <TextBlock Text="Fine Nudge Ruler 1px" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/>

                    <TextBlock Text="Ctrl + R" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                    <TextBlock Text="Reset Ruler to Defaults" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </UniformGrid>

                <TextBlock Text="Opacity Tweaks" Foreground="DarkCyan" FontWeight="Bold" FontSize="13" Margin="0,5,0,8"/>
                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <TextBlock Text="Page Up / Page Down" Foreground="#AAAAAA" Margin="0,3,0,3"/>
                    <TextBlock Text="Nudge Opacity Up / Down by 10%" Foreground="White" FontWeight="SemiBold" Margin="0,3,0,3"/>

                    <TextBlock Text="Shift + Page Up / Page Down" Foreground="DarkCyan" FontWeight="Bold" Margin="0,3,0,3"/>
                    <TextBlock Text="Nudge Opacity Up / Down by 5%" Foreground="White" FontWeight="SemiBold" Margin="0,3,0,3"/>

                    <TextBlock Text="Ctrl + Page Up" Foreground="#AAAAAA" Margin="0,3,0,3"/>
                    <TextBlock Text="Instant Snap to 100% Opacity" Foreground="White" FontWeight="SemiBold" Margin="0,3,0,3"/>

                    <TextBlock Text="Ctrl + Page Down" Foreground="#AAAAAA" Margin="0,3,0,3"/>
                    <TextBlock Text="Instant Snap to 10% Opacity" Foreground="White" FontWeight="SemiBold" Margin="0,3,0,3"/>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" 
                Content="Close" 
                Click="CloseButton_Click"
                Background="#2D2D30" 
                Foreground="White" 
                BorderThickness="0" 
                Padding="10,6" 
                HorizontalAlignment="Right"
                Cursor="Hand"/>
    </Grid>
</Window>
